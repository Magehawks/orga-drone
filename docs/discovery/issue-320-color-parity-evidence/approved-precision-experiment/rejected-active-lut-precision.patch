diff --git a/tests/test_studio_lut_precision.py b/tests/test_studio_lut_precision.py
new file mode 100644
--- /dev/null
+++ b/tests/test_studio_lut_precision.py
@@ -0,0 +1,82 @@
+"""Active-LUT precision and selective cache invalidation contracts."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from orga_drone.studio_image import ImageAdjust
+from orga_drone.studio_lut import ColorLook, ffmpeg_lut_chain, import_lut_from_path, write_identity_cube
+import orga_drone.studio_playback_proxy as proxy
+import orga_drone.studio_preview_frame as still
+
+
+@pytest.mark.parametrize("mode,affected", [
+    ("neutral", False), ("zero", False), ("unconfirmed", False),
+    ("creative", True), ("conversion", True),
+])
+def test_precision_changes_only_actual_lut_cache_entries(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, mode: str, affected: bool,
+) -> None:
+    data = tmp_path / "data"
+    asset = import_lut_from_path(data, write_identity_cube(tmp_path / "identity.cube"))
+    looks = {
+        "neutral": ColorLook(),
+        "zero": ColorLook(creative_lut=asset, creative_strength=0),
+        "unconfirmed": ColorLook(conversion_lut=asset, conversion_confirmed=False),
+        "creative": ColorLook(creative_lut=asset, creative_strength=50),
+        "conversion": ColorLook(conversion_lut=asset, conversion_confirmed=True),
+    }
+    look = looks[mode]
+    source = tmp_path / "synthetic.mp4"
+    source.write_bytes(b"synthetic cache-key fixture")
+    frame = still.PreviewFrameRequest(source, "video", 0, ImageAdjust(), look)
+    playback = proxy.PlaybackProxyRequest(source, source_end_s=1, look=look)
+    metadata = {"media_mtime_ns": source.stat().st_mtime_ns, "media_size": source.stat().st_size}
+    new_still = still.cache_key_for(frame, **metadata)
+    new_proxy = proxy.cache_key_for(playback, data_dir=data, **metadata)
+    with monkeypatch.context() as legacy:
+        legacy.setattr(still, "lut_precision_cache_version", lambda _: None)
+        legacy.setattr(proxy, "lut_precision_cache_version", lambda _: None)
+        old_still = still.cache_key_for(frame, **metadata)
+        old_proxy = proxy.cache_key_for(playback, data_dir=data, **metadata)
+    assert (new_still != old_still) is affected
+    assert (new_proxy != old_proxy) is affected
+    chain = ffmpeg_lut_chain(look, data_dir=data, work_dir=tmp_path / "work")
+    assert chain.startswith("format=gbrpf32le,lut3d=") is affected
+
+
+def test_old_active_lut_outputs_are_not_served_as_new_hits(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    data = tmp_path / "data"
+    asset = import_lut_from_path(data, write_identity_cube(tmp_path / "identity.cube"))
+    source = tmp_path / "synthetic.mp4"
+    original = b"synthetic source left untouched"
+    source.write_bytes(original)
+    look = ColorLook(creative_lut=asset)
+    frame = still.PreviewFrameRequest(source, "video", 0, ImageAdjust(), look)
+    playback = proxy.PlaybackProxyRequest(source, source_end_s=1, look=look)
+    metadata = {"media_mtime_ns": source.stat().st_mtime_ns, "media_size": source.stat().st_size}
+    with monkeypatch.context() as legacy:
+        legacy.setattr(still, "lut_precision_cache_version", lambda _: None)
+        legacy.setattr(proxy, "lut_precision_cache_version", lambda _: None)
+        old_still = still.cache_key_for(frame, **metadata)
+        old_proxy = proxy.cache_key_for(playback, data_dir=data, **metadata)
+    still_dir = still.preview_stills_dir(data)
+    proxy_dir = proxy.playback_proxies_dir(data)
+    proxy_dir.mkdir(parents=True, exist_ok=True)
+    (still_dir / f"{old_still}.jpg").write_bytes(b"legacy still sentinel")
+    (proxy_dir / f"{old_proxy}.mp4").write_bytes(b"legacy proxy sentinel")
+    assert proxy.cached_playback_proxy(playback, data_dir=data) is None
+    monkeypatch.setattr(still, "find_ffmpeg", lambda: None)
+    with pytest.raises(still.PreviewFrameError, match="Install ffmpeg"):
+        still.render_preview_frame(frame, data_dir=data)
+    new_frame = still_dir / f"{still.cache_key_for(frame, **metadata)}.jpg"
+    new_playback = proxy_dir / f"{proxy.cache_key_for(playback, data_dir=data, **metadata)}.mp4"
+    new_frame.write_bytes(b"new still sentinel")
+    new_playback.write_bytes(b"new proxy sentinel")
+    assert still.render_preview_frame(frame, data_dir=data) == new_frame
+    assert proxy.cached_playback_proxy(playback, data_dir=data) == new_playback
+    assert source.read_bytes() == original
