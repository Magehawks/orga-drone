diff --git a/src/orga_drone/static/js/studio/soft-wipe.js b/src/orga_drone/static/js/studio/soft-wipe.js
new file mode 100644
index 0000000..c388d98
--- /dev/null
+++ b/src/orga_drone/static/js/studio/soft-wipe.js
@@ -0,0 +1,51 @@
+// FFmpeg smoothleft: incoming weight = smoothstep(0, 1, x/W + 2*t - 1).
+// Apply to the finished incoming frame in output coordinates, not the source.
+export function isOverlapTransition(type) {
+  return type === "crossfade" || type === "soft_wipe_left";
+}
+
+export function softWipeAlpha(x, width, progress) {
+  const t = Math.max(0, Math.min(1, Number(progress) || 0));
+  const u = Math.max(0, Math.min(1, x / width + 2 * t - 1));
+  return u * u * (3 - 2 * u);
+}
+
+export function createSoftWipeCompositor(createCanvas = () => document.createElement("canvas")) {
+  const incoming = createCanvas();
+  const mask = createCanvas();
+  return function composite(ctx, width, height, progress, drawIncoming) {
+    if (incoming.width !== width || incoming.height !== height) {
+      incoming.width = width;
+      incoming.height = height;
+    }
+    if (mask.width !== width || mask.height !== 1) {
+      mask.width = width;
+      mask.height = 1;
+    }
+    const picture = incoming.getContext("2d");
+    const alpha = mask.getContext("2d");
+    if (!picture || !alpha) return false;
+    picture.setTransform(1, 0, 0, 1, 0, 0);
+    picture.globalCompositeOperation = "source-over";
+    picture.globalAlpha = 1;
+    picture.filter = "none";
+    picture.fillStyle = "#000";
+    picture.fillRect(0, 0, width, height);
+    if (!drawIncoming(picture)) return false;
+    const row = alpha.createImageData(width, 1);
+    for (let x = 0; x < width; x += 1) {
+      row.data[x * 4 + 3] = Math.round(255 * softWipeAlpha(x, width, progress));
+    }
+    alpha.putImageData(row, 0, 0);
+    picture.setTransform(1, 0, 0, 1, 0, 0);
+    picture.globalCompositeOperation = "destination-in";
+    picture.imageSmoothingEnabled = false;
+    picture.drawImage(mask, 0, 0, width, height);
+    picture.globalCompositeOperation = "source-over";
+    ctx.save();
+    ctx.setTransform(1, 0, 0, 1, 0, 0);
+    ctx.drawImage(incoming, 0, 0);
+    ctx.restore();
+    return true;
+  };
+}
