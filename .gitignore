# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Local app data / secrets
.env
data/
data-test/
*.db
*.sqlite
*.sqlite3

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Cursor: keep shared project agents/rules; ignore local-only state
# Do NOT ignore .github/ — CI, issue/PR templates belong in the repo
.cursor/*
!.cursor/agents/
!.cursor/agents/**
!.cursor/rules/
!.cursor/rules/**

# Packaging / PyInstaller
*.spec
!packaging/*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.log

# Local release build output (upload via GitHub Releases instead)
releases/*/orga-drone/
releases/*.zip
releases/**/*.zip

# Locale build artifacts (keep .po/.mo we commit)
*.pot

# Test media (never commit user videos)
*.MP4
*.LRF
*.SRT
*.JPG
*.JPEG
*.MOV
*.DNG

# README / docs screenshots (override media globs above)
!media/
!media/*.jpg
!media/*.jpeg
!media/*.png
!media/*.webp
!media/*.gif
!media/*.JPG
!media/*.JPEG
!media/*.PNG
!media/*.WEBP
!media/*.GIF
